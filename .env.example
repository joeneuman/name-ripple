# --- Server ---
PORT=3100
# Serve under a subpath behind nginx (e.g. /nameripple for hackbed.com/nameripple).
# Leave empty to serve at the root.
BASE_PATH=
# Optional basic auth for the whole UI/API. Leave blank to run open (fine behind a firewall;
# set these before exposing to the internet).
AUTH_USER=
AUTH_PASS=

# --- Daily scan (cron format, server local time) ---
# Verisign drops expired .coms in a daily batch, roughly 11am-2pm US Eastern.
# 18:00 UTC hits ~90% of the drop: 2:00pm EDT summer / 1:00pm EST winter. Early beats thorough.
CRON_SCHEDULE=0 18 * * *
# How many 4-letter .coms to DNS-check per day (rotates through all 456,976; 10000/day = full cycle ~46 days)
SCAN_FOUR_SLICE=10000
# 3-letter .coms are swept in full every day (17,576) unless disabled
SCAN_THREE_FULL=true
# Fresh pronounceable 5-letter candidates generated + checked per day
SCAN_FIVE_COUNT=500
# Concurrent DNS lookups during scans
DNS_CONCURRENCY=50

# --- AI features (name evaluation + word-list generation) ---
# Get a key at console.anthropic.com. Leave blank to disable AI features;
# everything else works without it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# --- Sign in with Google (per-user watched domains + Daily Scan) ---
# Create an OAuth client at console.cloud.google.com (see README). Leave blank to
# disable sign-in entirely — then the app runs open, with a single shared account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A long random string that signs the login cookie. Generate one, keep it secret.
SESSION_SECRET=
# The app's public base URL, used to build the Google redirect URI.
# Local: http://localhost:3100   Production: https://hackbed.com/nameripple
PUBLIC_URL=http://localhost:3100

# --- Email digest (leave SMTP_HOST blank to disable email; finds still appear on the dashboard) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM="Name Ripple <scoop@example.com>"
DIGEST_TO=joe@giddydigs.com
